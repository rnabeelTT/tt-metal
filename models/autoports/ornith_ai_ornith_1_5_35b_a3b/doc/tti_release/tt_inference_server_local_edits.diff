diff --git a/workflows/model_specs/prod/llm.yaml b/workflows/model_specs/prod/llm.yaml
index 814373f8..33959501 100644
--- a/workflows/model_specs/prod/llm.yaml
+++ b/workflows/model_specs/prod/llm.yaml
@@ -2897,3 +2897,47 @@ templates:
         # A request must leave one full output canvas inside max_context.
       max_effective_input_tokens: 261888

+
+# =============================================================================
+# LOCAL (uncommitted) entry: Ornith-1.5-35B-A3B tt-metal AUTOPORT.
+# Added by the tt-model-bringup stage-11 (tti-release) run so that
+# tt-inference-server can run its release workflow against the GENERATED
+# implementation at models/autoports/ornith_ai_ornith_1_5_35b_a3b, rather than
+# any stock packaged model. The entry exists for two reasons:
+#   1. impl ornith_autoport carries code_path=models/autoports/... so every
+#      run spec / report identifies the autoport under test;
+#   2. EVAL_CONFIGS is built as the intersection of MODEL_SPECS and the eval
+#      config list, so an eval/release run for this HF repo needs a catalog
+#      entry to exist at all.
+# Serving profile is the one measured in stages 09/10: ONE Blackhole die
+# (P150), max_num_seqs 1 (batched serving is unfinished), full 262144 context
+# per doc/context_contract.json, HOST sampling (this model cannot sample on
+# device: vocab 248320 > 65536/die on a 1x1 mesh), fabric DISABLED.
+# =============================================================================
+- weights:
+    - ornith-ai/Ornith-1.5-35B-A3B
+  version: "0.21.0"
+  tt_metal_commit: "72f2033326e"
+  vllm_commit: "0.26.0"
+  impl: ornith_autoport
+  inference_engine: VLLM
+  model_type: LLM
+  supported_modalities:
+    - text
+  device_model_specs:
+    - device: P150
+      max_concurrency: 1
+      max_context: 262144
+      default_impl: true
+      env_vars:
+        MESH_DEVICE: P150
+        EXTRA_MODELS_DIR: models/autoports
+      vllm_args:
+        block_size: "64"
+        max_model_len: "262144"
+        max_num_seqs: "1"
+      override_tt_config:
+        trace_region_size: 1073741824
+        fabric_config: DISABLED
+  status: EXPERIMENTAL
+  has_builtin_warmup: false
