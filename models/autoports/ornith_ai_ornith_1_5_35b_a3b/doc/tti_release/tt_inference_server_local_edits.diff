diff --git a/reference_config/evals/eval_config.py b/reference_config/evals/eval_config.py
index d3876ada..3e6a5650 100644
--- a/reference_config/evals/eval_config.py
+++ b/reference_config/evals/eval_config.py
@@ -6193,6 +6193,93 @@ _eval_config_list = [
             ),
         ],
     ),
+    # =========================================================================
+    # LOCAL (uncommitted) entry: Ornith-1.5-35B-A3B tt-metal AUTOPORT.
+    # Added by the tt-model-bringup stage-11 (tti-release) run. EVAL_CONFIGS is
+    # the intersection of MODEL_SPECS and this list, so the autoport catalog
+    # entry in workflows/model_specs/prod/llm.yaml needs a matching eval config
+    # for `--workflow evals` / `--workflow release` to be allowed to run at all.
+    #
+    # Task DEFINITIONS are reused from the existing text-LLM entries
+    # (Falcon3-7B-Instruct's ifeval, the GPQA-Diamond zero-shot CoT task), as
+    # the tti-release skill permits. Reference SCORES are NOT reused: no
+    # Tenstorrent or GPU reference measurement exists for this model, so
+    # gpu_reference_score is None on both tasks and the accuracy rows are
+    # reported as measured-but-ungated (N/A) rather than graded against another
+    # model's baseline. published_score is set only where the model's own card
+    # publishes a number, and GPQA Diamond's 89.2 there is a full-set
+    # thinking-mode result from a different harness -- disclosure, not a gate.
+    #
+    # Sampling comes from the model's own generation_config.json
+    # (do_sample=true, temperature=1.0, top_k=20, top_p=0.95). The chat template
+    # is applied from the HF tokenizer (apply_chat_template defaults True), as
+    # required for an instruct model. max_concurrent is 1 because the autoport
+    # serves max_num_seqs=1; per-task max_length is an EVAL prompt budget only
+    # and does not change the served context (262144, per
+    # models/autoports/ornith_ai_ornith_1_5_35b_a3b/doc/context_contract.json).
+    # =========================================================================
+    EvalConfig(
+        hf_model_repo="ornith-ai/Ornith-1.5-35B-A3B",
+        tasks=[
+            EvalTask(
+                task_name="ifeval",
+                max_concurrent=1,
+                workflow_venv_type=WorkflowVenvType.EVALS_COMMON,
+                # Chat API, not /v1/completions. This model's chat template
+                # opens a <think> block, so it emits a reasoning trace before
+                # the answer. The first stage-11 release run scored ifeval over
+                # /v1/completions, where 27 of 28 sampled responses contained
+                # "</think>" and the reasoning text was scored as part of the
+                # answer -- which mechanically violates constraints such as "do
+                # not use any commas" and produced an uninterpretable 32.14.
+                # vLLM's reasoning parser only applies to the chat endpoint, so
+                # the server runs with --reasoning-parser qwen3 and this task
+                # uses the chat API, which is the model's declared serving
+                # contract. This changes only how the response is parsed; it
+                # changes no prompt, no sample count and no context limit.
+                use_chat_api=True,
+                model_kwargs={"max_length": 16384},
+                gen_kwargs={
+                    "stream": "false",
+                    "max_gen_toks": 2048,
+                    "do_sample": "true",
+                    "temperature": 1.0,
+                    "top_k": 20,
+                    "top_p": 0.95,
+                },
+                score=EvalTaskScore(
+                    published_score=None,
+                    published_score_ref=None,
+                    gpu_reference_score=None,
+                    gpu_reference_score_ref=None,
+                    score_func=score_task_single_key,
+                    score_func_kwargs={
+                        "result_keys": [
+                            "prompt_level_strict_acc,none",
+                            "inst_level_strict_acc,none",
+                        ],
+                        "unit": "percent",
+                    },
+                ),
+                limit_samples_map={
+                    EvalLimitMode.CI_NIGHTLY: 0.05,
+                    EvalLimitMode.SMOKE_TEST: 0.01,
+                },
+            ),
+            # NOT RUN HERE: gpqa_diamond_cot_zeroshot / meta_gpqa_cot. The
+            # tti-release skill treats GPQA-CoT as a mandatory quality gate for
+            # text LLMs, but every GPQA task in this harness reads the gated HF
+            # dataset Idavidrein/gpqa, and this environment has no HF token with
+            # access to it: load_dataset("Idavidrein/gpqa", "gpqa_diamond")
+            # raises DatasetNotFoundError ("gated dataset ... must be
+            # authenticated"). That is an environment blocker, not a property
+            # of the autoport. It is recorded as an UN-RUN mandatory gate in
+            # models/autoports/ornith_ai_ornith_1_5_35b_a3b/doc/tti_release/
+            # RUN_NOTES.md rather than swapped for an unrelated task, waived,
+            # or quietly dropped. Re-add this task once a token with GPQA
+            # access is available.
+        ],
+    ),
 ]


