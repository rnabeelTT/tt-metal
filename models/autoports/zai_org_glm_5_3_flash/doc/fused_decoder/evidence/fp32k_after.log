        rcfg = MHCConfig(n=N, sinkhorn_iters=ITERS, eps=HC_EPS)
        pre_r, post_r, comb_r = parametrize(mixes.double(), scale.double(), base.double(), rcfg)
        got = {
            "pre": ttnn.to_torch(pre).float()[:T, :N],
