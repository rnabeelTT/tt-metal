        perm = torch.randperm(attn.NB - 1, generator=torch.Generator().manual_seed(11))[: BATCH * bps].reshape(BATCH, bps)
        assert not torch.equal(perm, attn.default_page_table()[:, :bps])
        dec.set_page_table(perm)
