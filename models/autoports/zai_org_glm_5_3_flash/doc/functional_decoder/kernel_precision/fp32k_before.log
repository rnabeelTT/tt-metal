        gram_diag = p[:, 32:].reshape(T // 32, 32, 32).diagonal(dim1=1, dim2=2).reshape(T)
        got = p[:, :32] * torch.rsqrt(gram_diag.reshape(T, 1) / K + EPS)
        ss_err = (gram_diag.double() / x.double().pow(2).sum(-1) - 1).abs().max().item()
