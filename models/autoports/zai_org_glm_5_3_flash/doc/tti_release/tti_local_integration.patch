+
+# GLM-5.3-Flash E192 agentic autoport (models/autoports/zai_org_glm_5_3_flash), text-only, 4 Blackhole dies (P300x2).
+# Served externally from the tt-metal release worktree (docker_server / local_server false) with the autoport's
+# serving profile p300x2-1m (serving_profiles.json): 1 sequence x 1,048,576 tokens = doc/context_contract.json
+# supported_context, block-sharded fp8 DSA cache. The numbers below equal that profile (max_num_seqs,
+# max_model_len, trace region, profile env); the server launch reads them from serving_profiles.json.
+- weights:
+  - zai-org/GLM-5.3-Flash
+  impl: glm53_flash_autoport
+  inference_engine: VLLM
+  model_type: LLM
+  supported_modalities:
+  - text
+  device_model_specs:
+  - device: P300X2
+    max_concurrency: 1
+    max_context: 1048576
+    default_impl: true
+    env_vars:
+      HF_MODEL: zai-org/GLM-5.3-Flash
+      MESH_DEVICE: P300x2
+      ARCH_NAME: blackhole
+      EXTRA_MODELS_DIR: models/autoports/zai_org_glm_5_3_flash/vllm_bundle
+      GLM53_TRACE_REGION: '67108864'
+      GLM53_DSA_SHARD: '1'
+      GLM53_MOE_SORTED_ROWS: '512'
+      GLM53_DSA_INDEX_BLOCK_MB: '32'
+    vllm_args:
+      block_size: '128'
+      enable_auto_tool_choice: true
+      reasoning_parser: glm45
+      tool_call_parser: glm47
+    override_tt_config:
+      fabric_config: FABRIC_1D
+      trace_region_size: 67108864
+      l1_small_size: 24576
+      sample_on_device_mode: all
+  # FUNCTIONAL (not EXPERIMENTAL): eval failures must block acceptance for this model's reports
+  status: FUNCTIONAL
+  has_builtin_warmup: true
+  metadata:
+    zai-org/GLM-5.3-Flash:
+      reasoning_parser_name: glm45
+      tool_call_parser_name: glm47
