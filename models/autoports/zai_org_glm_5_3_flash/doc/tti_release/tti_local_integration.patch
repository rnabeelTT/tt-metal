+def _message_text(message):
+    """The generated text of a chat message. An always-thinking model (GLM-5.3-Flash: the chat template opens <think>
+    on every turn) served with a reasoning parser returns the think text in `reasoning` / `reasoning_content` and
+    `content` = null until the think block closes; these parameter tests observe the generated text, so take the
+    answer when there is one, else the reasoning."""
+    return message.get("content") or message.get("reasoning_content") or message.get("reasoning") or ""
+
+
