 # Note: reasoning models (QwQ-32B, DeepSeek-R1-Distill-Llama-70B) need evals allowing more tokens generated
 
 
+def _glm53_flash_tasks(names):
+    """GLM-5.3-Flash E192 autoport eval rows (models/autoports/zai_org_glm_5_3_flash). GLM53_EVAL_TASKS (comma list)
+    restricts a run to the named tasks."""
+    keep = os.environ.get("GLM53_EVAL_TASKS")
+    return [t for t in names if not keep or t.task_name in keep.split(",")]
+
+
+def _glm53_gen_kwargs(task, effort, max_gen_toks):
+    """GLM-5.3-Flash E192 request knobs: GLM53_EVAL_EFFORT_<TASK> (low / high / max / default = no field, the chat
+    template's default = max) and GLM53_EVAL_MAX_GEN_TOKS_<TASK>."""
+    kw = {
+        "max_gen_toks": os.environ.get(f"GLM53_EVAL_MAX_GEN_TOKS_{task}", max_gen_toks),
+        "until": ["<|endoftext|>"],
+        "do_sample": "true",
+        "temperature": 1.0,
+        "top_p": 0.95,
+        "stream": "false",
+    }
+    effort = os.environ.get(f"GLM53_EVAL_EFFORT_{task}", effort)
+    if effort != "default":
+        kw["reasoning_effort"] = effort
+    return kw
+
+
