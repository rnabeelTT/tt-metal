 }
 
 
+# Models whose tokenizer needs transformers >= 5 (tokenizer_class TokenizersBackend): the shared client venv
+# (vllm 0.13 / transformers 4.57) cannot load it, so they use the newer client venv (vllm 0.19.1 / transformers 5.5.1).
+_VLLM_BENCHMARK_VENV_BY_MODEL = {
+    "zai-org/GLM-5.3-Flash": WorkflowVenvType.BENCHMARKS_VLLM_FORGE,
+}
+
+
 def select_vllm_benchmark_venv(model_spec) -> WorkflowVenvType:
     """Pick the vllm benchmark client venv for ``model_spec``."""
+    by_model = _VLLM_BENCHMARK_VENV_BY_MODEL.get(getattr(model_spec, "hf_model_repo", None))
+    if by_model is not None:
+        return by_model
     return _VLLM_BENCHMARK_VENV_BY_ENGINE.get(
         model_spec.inference_engine, WorkflowVenvType.BENCHMARKS_VLLM
     )
