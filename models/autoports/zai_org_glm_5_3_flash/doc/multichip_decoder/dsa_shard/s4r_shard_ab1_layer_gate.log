        ref, t_ref = _run(mesh, rd, False, cfg["batch"], cfg["max_context"], users, perm_seed=11)
        got, t_got = _run(mesh, rd, True, cfg["batch"], cfg["max_context"], users, perm_seed=11)
        worst_p, worst_r = 1.0, 0.0
        fails = []
