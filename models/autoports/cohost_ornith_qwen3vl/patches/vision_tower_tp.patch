+def pos_embed_interpolate(visual, grid_thw: torch.Tensor) -> torch.Tensor:
+    """Qwen3-VL's bilinearly interpolated position embedding in merge-window order, as transformers 5.12's
+    ``fast_pos_embed_interpolate`` computes it (later releases dropped the method)."""
+    side, merge = int(visual.config.num_position_embeddings**0.5), visual.config.spatial_merge_size
+    idx_parts, weight_parts = [[] for _ in range(4)], [[] for _ in range(4)]
+    for t, h, w in grid_thw.tolist():
+        t, h, w = int(t), int(h), int(w)
+        h_grid, w_grid = torch.linspace(0, side - 1, h), torch.linspace(0, side - 1, w)
+        h_floor, w_floor = h_grid.int(), w_grid.int()
+        h_ceil, w_ceil = (h_floor + 1).clamp(max=side - 1), (w_floor + 1).clamp(max=side - 1)
+        h_frac, w_frac = h_grid - h_floor, w_grid - w_floor
+        hf, hc = h_floor * side, h_ceil * side
+        corners = [
+            (hf[:, None] + w_floor[None, :]).flatten(),
+            (hf[:, None] + w_ceil[None, :]).flatten(),
+            (hc[:, None] + w_floor[None, :]).flatten(),
+            (hc[:, None] + w_ceil[None, :]).flatten(),
+        ]
+        weights = [
+            ((1 - h_frac)[:, None] * (1 - w_frac)[None, :]).flatten(),
+            ((1 - h_frac)[:, None] * w_frac[None, :]).flatten(),
+            (h_frac[:, None] * (1 - w_frac)[None, :]).flatten(),
+            (h_frac[:, None] * w_frac[None, :]).flatten(),
+        ]
+        h_idx = torch.arange(h).view(h // merge, merge)
+        w_idx = torch.arange(w).view(w // merge, merge)
+        reorder = (h_idx[:, :, None, None] * w + w_idx[None, None, :, :]).transpose(1, 2).flatten().repeat(t)
+        for i in range(4):
+            idx_parts[i].append(corners[i][reorder])
+            weight_parts[i].append(weights[i][reorder])
+    idx = torch.stack([torch.cat(p) for p in idx_parts])
+    wts = torch.stack([torch.cat(p) for p in weight_parts])
+    return (visual.pos_embed(idx) * wts[:, :, None]).sum(0)
+
