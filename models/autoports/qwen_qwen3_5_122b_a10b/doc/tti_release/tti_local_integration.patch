 # Note: reasoning models (QwQ-32B, DeepSeek-R1-Distill-Llama-70B) need evals allowing more tokens generated
 
 
+def _qwen35_sampling() -> dict:
+    """Decoding for the Qwen3.5-122B-A10B autoport evals. Default greedy (the non-thinking release configuration).
+    QWEN35_EVAL_SAMPLING selects a model-card preset (README "recommended sampling parameters"):
+      thinking        = "Thinking mode for general tasks": temperature 1.0, top_p 0.95, top_k 20, presence_penalty 1.5
+      thinking_coding = "Thinking mode for precise coding tasks": temperature 0.6, top_p 0.95, top_k 20 (used by the stage-11 run 6
+                        by mistake; kept so that run is reproducible)
+      instruct        = "Instruct (non-thinking) mode for general tasks": temperature 0.7, top_p 0.8, top_k 20, presence_penalty 1.5
+    Qwen documents that greedy decoding in thinking mode degrades and can loop, and that presence_penalty reduces repetitions."""
+    preset = os.environ.get("QWEN35_EVAL_SAMPLING")
+    if preset == "thinking":
+        return {"do_sample": "true", "temperature": 1.0, "top_p": 0.95, "top_k": 20, "presence_penalty": 1.5}
+    if preset == "thinking_coding":
+        return {"do_sample": "true", "temperature": 0.6, "top_p": 0.95, "top_k": 20}
+    if preset == "instruct":
+        return {"do_sample": "true", "temperature": 0.7, "top_p": 0.8, "top_k": 20, "presence_penalty": 1.5}
+    return {"do_sample": "false"}
+
+
